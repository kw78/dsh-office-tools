{
  "name": "dsh-office-tools",
  "version": "0.6.0",
  "description": "DSH model-facing Office tools: create, read, and update Word (.docx), Excel (.xlsx), and PowerPoint (.pptx) files inside the session workspace.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/*.js",
    "lib/types",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "docx": "^9.5.1",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "author": "kw78",
  "homepage": "https://github.com/kw78/dsh-office-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kw78/dsh-office-tools.git"
  },
  "bugs": {
    "url": "https://github.com/kw78/dsh-office-tools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "office",
    "word",
    "excel",
    "powerpoint",
    "docx",
    "xlsx",
    "pptx",
    "tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.7.0"
}
